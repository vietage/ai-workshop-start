{
  "serve": true,
  "steps": [
    { "goto": "/", "pause": 800 },
    { "caption": "Scan from the keyboard: type a link, then Enter" },
    { "type": "#repo", "text": "./fixture", "pause": 300 },
    { "press": "Enter" },
    { "waitFor": "#skills li", "pause": 1500 },
    { "caption": "Tab: Scan, the filter, then the skills, on the selected one" },
    { "press": "Tab", "pause": 700 },
    { "press": "Tab", "pause": 700 },
    { "press": "Tab", "pause": 1500 },
    { "caption": "The arrow keys move the focus (an outline); the selection stays" },
    { "press": "ArrowDown", "pause": 800 },
    { "press": "ArrowDown", "pause": 1500 },
    { "caption": "Enter selects it: its SKILL.md" },
    { "press": "Enter", "pause": 2000 },
    { "caption": "Space too" },
    { "press": "ArrowDown", "pause": 800 },
    { "press": " ", "pause": 2000 },
    { "caption": "In the filter, ArrowDown goes on to the skills" },
    { "press": "Shift+Tab", "pause": 800 },
    { "type": "#filter", "text": "commit", "pause": 800 },
    { "press": "ArrowDown", "pause": 800 },
    { "press": "ArrowDown", "pause": 800 },
    { "press": "Enter", "pause": 2000 },
    { "caption": "An organisation: Tab reaches its repositories; arrows, then Enter opens one" },
    { "fill": "#filter" },
    { "fill": "#repo", "text": "github.com/Kotlin" },
    { "press": "Enter" },
    { "waitFor": "#repositories li", "timeout": 180000, "pause": 1500 },
    { "press": "Tab", "pause": 700 },
    { "press": "Tab", "pause": 700 },
    { "press": "ArrowDown", "pause": 700 },
    { "press": "ArrowDown", "pause": 700 },
    { "press": "Enter" },
    { "waitFor": "#scan:enabled", "pause": 3000 },
    { "caption": "", "pause": 500 }
  ]
}
