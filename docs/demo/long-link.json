{
  "serve": true,
  "typingDelay": 25,
  "steps": [
    {
      "goto": "/",
      "pause": 800
    },
    {
      "caption": "A link over 16 KB: https://github.com/ and 20,000 a"
    },
    {
      "fill": "#repo",
      "text": "https://github.",
      "pause": 1500
    },
    {
      "click": "#scan"
    },
    {
      "waitFor": "#error:not(:empty)",
      "timeout": 60000,
      "pause": 3500
    },
    {
      "caption": "Its scan's message, as the CLI's, not a JSON parser's error"
    },
    {
      "pause": 2500
    },
    {
      "caption": "Reload: the page, and the same message, for the link in the URL"
    },
    {
      "reload": true
    },
    {
      "waitFor": "#error:not(:empty)",
      "timeout": 60000,
      "pause": 3500
    },
    {
      "caption": "The API: status 400 and { error } as JSON, not a 431 with no body"
    },
    {
      "run": "./skill-atlas serve --port 4180 >/dev/null 2>&1 & sleep 1; curl -s -i \"localhost:4180/api/scan?repo=https://github.com/$(printf 'a%.0s' $(seq 20000))\" | head -c 260; kill $!",
      "pause": 4500
    },
    {
      "caption": "",
      "pause": 500
    }
  ]
}
